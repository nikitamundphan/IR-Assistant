DSX_BASE_URL=https://dsxdev-online.dsone.3ds.com/enovia/rest/devops/v1
# Coal Porter OpenAPI (same host): {DSX_BASE_URL}/api-docs
# UI REST for saved IR templates (Translate_IR formtemplates)
DSX_UI_BASE_URL=https://dsxdev-online.dsone.3ds.com/enovia/rest/ui/v1
# 3DEXPERIENCE Navigator (open objects by physicalId) — same host as emxNavigator.jsp
DSX_WEB_BASE_URL=https://dsxdev-online.dsone.3ds.com/enovia
# Optional server-side fallback when no user session is present (dev only)
DSX_CREDENTIALS=your_login:your_api_key
# Allow one-click login using DSX_CREDENTIALS from .env (default: true when set)
# IR_ALLOW_ENV_LOGIN=true
# Optional: override saved form list query (Translate_IR templates use /rest/ui/v1/formtemplates)
# DSX_CREATION_FORMS_PATH=/formtemplates?owner=your_trigram&type=ECR&current=true
DSX_CREATION_FORMS_PATH=
# DSX hierarchy lookup for mandatory dashboard flow: Service → Program → Release (rel_eno_id).
# Required before filing; saved form templates still load from DSX_UI_BASE_URL / formtemplates.
# On Coal Porter dev servers, brands list at GET /brands; product services at GET /services?brand=...
DSX_SERVICES_PATH=/brands
DSX_PRODUCT_SERVICES_PATH=/services
DSX_PROGRAMS_PATH=/programs
DSX_RELEASES_PATH=/releases/{program_id}
DSX_PROGRAMS_SERVICE_PARAM=service
DSX_RELEASES_PROGRAM_PARAM=program
# Auto-select brand scope for GET /services (skips manual brand pick when DSX matches this name).
# Not your target release — use product service → program → release in the UI (e.g. AIAssistantInfra → 1.9x).
DSX_PARENT_BRAND_NAME=3DEXPERIENCE Platform
# Optional: cap slow fallback API probes when the Coal Porter fast path misses (default 12)
# DSX_PROBE_MAX_ATTEMPTS=12
